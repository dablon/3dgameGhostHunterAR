{
  "name": "three-blender-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ghost Hunter AR — Three.js + Rapier + AR.js ghost-hunting game with ECS architecture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "assets:export": "node blender/run.mjs",
    "verify": "node verify.mjs",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
